{
  "name": "orchestra",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "web": "npm --prefix web run dev",
    "web:install": "npm --prefix web install",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "seed": "npm run seed -w server",
    "load": "npm run load -w server --",
    "sim": "npm run sim -w server --",
    "check": "npm run check -w server --",
    "demo": "npm run sim -w server -- --url https://orchestra-api-production-f275.up.railway.app --reset --loop",
    "demo:backup": "npm run sim -w server -- --url https://orchestra-api-am50.onrender.com --reset --loop",
    "demo:local": "npm run sim -w server -- --reset --loop"
  },
  "engines": {
    "node": ">=22"
  }
}
